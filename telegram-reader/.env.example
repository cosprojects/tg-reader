# --- Telegram Bot API (читается только в server/) ---
BOT_TOKEN=
MINI_APP_URL=
API_PORT=3001

# --- Публичный адрес backend ---
# Его использует Mini App: GET ${PUBLIC_API_BASE}/api/posts/:id.
# Локально: http://localhost:3001
# Для Telegram (Mini App по HTTPS): https://<temporary-backend-url> — адрес туннеля.
# Значение подставляется в Mini App на этапе сборки (см. app/vite.config.js),
# поэтому после изменения адреса Mini App нужно пересобрать.
PUBLIC_API_BASE=http://localhost:3001

# --- Text-to-Speech ---
# Провайдер выбирается здесь: none | piper | openai | macos-say.
#   piper     — локальный синтез, ключ и сеть не нужны (см. блок ниже)
#   openai    — облачный, нужен TTS_API_KEY
#   macos-say — локальный `say` из macOS, только для отладки
#   none      — провайдер не подключён: POST /api/posts/:id/audio вернёт заглушку
# Подробности — в docs/tts.md.
TTS_PROVIDER=none
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Столько символов уходит провайдеру за один запрос; более длинный текст режется
# на части по предложениям и синтезируется по частям.
TTS_MAX_CHARS=4096

# --- Piper (локальный синтез) ---
# Python обязательно из venv: piper-tts зависит от onnxruntime, а под системный
# python3 3.9 колёс onnxruntime под macOS arm64 нет.
#   /usr/local/bin/python3 -m venv ~/.local/share/piper-venv
#   ~/.local/share/piper-venv/bin/pip install piper-tts certifi
#   ~/.local/share/piper-venv/bin/python3 -m piper.download_voices ru_RU-ruslan-medium --data-dir server/.piper-voices
TTS_PIPER_PYTHON=
TTS_PIPER_MODEL=ru_RU-ruslan-medium
# Пусто — server/.piper-voices
TTS_PIPER_DATA_DIR=

# Каталог для сгенерированного аудио. Пусто — server/.audio-cache.
AUDIO_CACHE_DIR=

# --- Silero (второй локальный провайдер, для сравнения с Piper) ---
# Свой venv внутри server/, окружение Piper не затрагивается:
#   /usr/local/bin/python3 -m venv server/.venv-silero
#   server/.venv-silero/bin/pip install silero certifi
# Модели скачиваются при первом запуске в server/.venv-silero/.../silero/model/
TTS_SILERO_PYTHON=
TTS_SILERO_MODEL=v5_5_ru
TTS_SILERO_SAMPLE_RATE=48000
# Предел длины одной части для Silero: модель падает примерно с 1200 символов,
# на 1000 сама предупреждает. Больше стандартных 4096 не ставить.
TTS_SILERO_MAX_CHARS=800
# Пусто — server/silero_tts_cli.py и server/.silero
TTS_SILERO_SCRIPT=
TTS_SILERO_DATA_DIR=

# --- Сжатие WAV → m4a ---
# Провайдеры пишут WAV, Mini App получает m4a. Пусто — по платформе:
# afconvert на macOS, ffmpeg на сервере (в образе ставится пакетом). Если в окружении
# есть только один из них, значение задаётся явно: afconvert | ffmpeg.
TTS_AUDIO_COMPRESSOR=

# --- Нормализация текста перед синтезом ---
# Числа, проценты и деньги превращаются в слова до TTS: Silero не читает цифры,
# а Piper читает их по-своему. off полностью отключает слой.
TTS_NORMALIZE=on

# Адрес разработчика для кнопки «📮 Связаться» (пусто — кнопки не будет)
SUPPORT_CONTACT=
